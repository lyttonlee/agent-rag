# docker-compose.app.yml 环境变量示例（复制为 .env 后修改）
# —— JWT_SECRET / PG_PASSWORD 没有安全默认值，缺失时 compose 启动即报错 ——
# —— 以下变量与 backend/.env 完全同构，镜像运行配置以此为准；改这里 + up -d 即生效 ——

# 运行环境与日志
ENVIRONMENT=dev            # dev/test/production；production 会拒绝 cloud Provider（涉密不出网）
LOG_LEVEL=INFO

# PostgreSQL（部署方既有实例；开发联调指向宿主机）
PG_HOST=host.docker.internal
PG_PORT=5432
PG_USER=rag
PG_PASSWORD=请改为部署方数据库密码
PG_DATABASE=gov_doc_rag

# 对象存储（默认 local：原文写 storage-data 卷）
STORAGE_PROVIDER=local
STORAGE_ROOT=/app/data/gov-doc
# s3 / SeaweedFS 模式（STORAGE_PROVIDER 改为 s3 或 SeaweedFS 时生效）
STORAGE_S3_ENDPOINT=127.0.0.1:8333
STORAGE_S3_BUCKET=gov-doc
STORAGE_S3_ACCESS_KEY=admin
STORAGE_S3_SECRET_KEY=admin123
STORAGE_S3_REGION=us-east-1
STORAGE_S3_SECURE=false
STORAGE_S3_ADDRESSING_STYLE=path

# 模型端点（部署方 vLLM / 自有算力中心，OpenAI 兼容）
MODEL_GEN_BASE_URL=http://host.docker.internal:8000/v1
MODEL_GEN_API_KEY=EMPTY
MODEL_GEN_NAME=qwen3-32b-instruct
MODEL_EMB_BASE_URL=http://host.docker.internal:8001/v1
MODEL_EMB_API_KEY=EMPTY
MODEL_EMB_NAME=qwen3-embedding-4b
EMBEDDING_DIM=1024
MODEL_RERANK_BASE_URL=http://host.docker.internal:8002/v1
MODEL_RERANK_API_KEY=EMPTY
MODEL_RERANK_NAME=qwen3-reranker-0.6b

# Redis（可选组件，当前代码未接入；配了也不影响启动）
REDIS_URL=redis://host.docker.internal:6379/0

# 密钥（务必替换！部署方自行保管）
JWT_SECRET=请改为足够长的随机密钥
ADMIN_PASSWORD=请改为管理员初始密码

# 宿主机端口映射（宿主机端口:容器端口）
BACKEND_PORT=8000
FRONTEND_PORT=80
