# ===== 基础 =====
APP_NAME=GovDoc-RAG
APP_VERSION=1.2.0
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ===== PostgreSQL + pgvector =====
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=rag
PG_PASSWORD=rag123456
PG_DATABASE=gov_doc_rag

# ===== 对象存储（抽象层：local 本地文件系统 / s3 兼容 SeaweedFS 等）=====
# 默认 local：零镜像、零协议风险；s3 模式可指向 SeaweedFS / Ceph RGW / 国产对象存储
STORAGE_PROVIDER=local
STORAGE_ROOT=./data/gov-doc
# 以下仅 s3 模式使用
STORAGE_S3_ENDPOINT=127.0.0.1:8333
STORAGE_S3_BUCKET=gov-doc
STORAGE_S3_ACCESS_KEY=admin
STORAGE_S3_SECRET_KEY=admin123
STORAGE_S3_REGION=us-east-1
STORAGE_S3_SECURE=false

# ===== 模型 Provider（local = 我方 Qwen3 栈 vLLM）=====
MODEL_GEN_BASE_URL=http://127.0.0.1:8000/v1
MODEL_GEN_API_KEY=EMPTY
MODEL_GEN_NAME=qwen3-32b-instruct
MODEL_EMB_BASE_URL=http://127.0.0.1:8001/v1
MODEL_EMB_API_KEY=EMPTY
MODEL_EMB_NAME=qwen3-embedding-4b
EMBEDDING_DIM=1024
MODEL_RERANK_BASE_URL=http://127.0.0.1:8002/v1
MODEL_RERANK_API_KEY=EMPTY
# 注意：模型名必须与服务端 GET $MODEL_RERANK_BASE_URL/models 返回的 id 严格一致，
# 否则 rerank 调用 404、检索静默降级 RRF（vLLM 常用 /modelscope_cache/... 全路径名）。
MODEL_RERANK_NAME=qwen3-reranker-0.6b

# 生产环境拒绝云端 Provider（涉密不出网）
FORBID_CLOUD_IN_PRODUCTION=true
